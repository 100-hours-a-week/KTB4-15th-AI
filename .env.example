# --- 가상피팅 ---
DATABASE_URL=postgresql://USER@localhost:5432/DB_NAME
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
SEARCH_DB_POOL_MIN_SIZE=1
SEARCH_DB_POOL_MAX_SIZE=5

AWS_REGION=ap-northeast-2
S3_BUCKET=
# V2 비동기 가상피팅 Presigned URL 유효기간(초): 사용자 원본 GET, 결과 업로드 PUT, 결과 GET.
VIRTUAL_FITTING_USER_IMAGE_URL_EXPIRES_SECONDS=1800
VIRTUAL_FITTING_RESULT_UPLOAD_URL_EXPIRES_SECONDS=3600
VIRTUAL_FITTING_RESULT_IMAGE_URL_EXPIRES_SECONDS=600
# V2 비동기 가상피팅 SQS Standard 큐 URL(https://sqs.<AWS_REGION>.amazonaws.com/<계정ID>/<큐이름>).
# 큐·DLQ·IAM 은 Cloud 담당. 자격증명은 S3 와 같은 기본 credential chain(EC2 IAM Role)을 쓴다.
BE_FITTING_REQUEST_QUEUE_URL=
AI_FITTING_RESPONSE_QUEUE_URL=
BE_FITTING_RESPONSE_QUEUE_URL=
# V2 요청 Worker. FastAPI 와 함께 시작·종료한다(별도 실행 명령 없음). 기본 false: 꺼져 있으면 Worker 용 SQS client 를 만들지 않는다.
# 켜면 아직 끝나지 않은 메시지가 반복 수신 뒤 DLQ 로 갈 수 있다. 운영 활성화는 Pruna·Webhook·후처리·결과 발행·복구 경로를 함께 확인한 뒤 정한다.
VIRTUAL_FITTING_REQUEST_WORKER_ENABLED=false
# 실행 권한(DB lease)·메시지 숨김 시간(SQS Visibility Timeout) 연장 단위(처리 단계 사이에서만 연장)와
# 종료 대기 시간(초). 종료 대기는 전체 상한이 아니다: 넘으면 수신 대기만 버리고, 처리 중인 단계는 끝날 때까지 기다린다.
VIRTUAL_FITTING_REQUEST_LEASE_SECONDS=120
VIRTUAL_FITTING_REQUEST_VISIBILITY_SECONDS=120
VIRTUAL_FITTING_REQUEST_SHUTDOWN_TIMEOUT_SECONDS=30
# AI 후처리 Worker(ai-fitting-response). 기본 꺼짐. 켜도 11·13단계 핸들러가 연결되기 전에는 수신하지 않는다(not_ready).
VIRTUAL_FITTING_POSTPROCESS_WORKER_ENABLED=false
VIRTUAL_FITTING_POSTPROCESS_LEASE_SECONDS=300
VIRTUAL_FITTING_POSTPROCESS_VISIBILITY_SECONDS=300
VIRTUAL_FITTING_POSTPROCESS_SHUTDOWN_TIMEOUT_SECONDS=30
# 결과 전송 루프(be-fitting-response). 기본 꺼짐. 켜면 DB 의 PUBLISH_RESULT·PENDING 결과를 최초 포함 최대 3회 보낸다.
VIRTUAL_FITTING_RESULT_PUBLISHER_ENABLED=false
VIRTUAL_FITTING_RESULT_PUBLISHER_POLL_SECONDS=2
VIRTUAL_FITTING_RESULT_PUBLISHER_LEASE_SECONDS=180
VIRTUAL_FITTING_RESULT_PUBLISHER_SHUTDOWN_TIMEOUT_SECONDS=30
# Watchdog(미완료 작업 조사·복구·운영 이상 탐지). 기본 꺼짐. 켜기 전에 scripts/db/virtual_fitting_watchdog.sql 을 적용한다.
VIRTUAL_FITTING_WATCHDOG_ENABLED=false
VIRTUAL_FITTING_WATCHDOG_INTERVAL_SECONDS=60
VIRTUAL_FITTING_WATCHDOG_BATCH_SIZE=20
VIRTUAL_FITTING_WATCHDOG_STATUS_MIN_INTERVAL_SECONDS=1
VIRTUAL_FITTING_WATCHDOG_SHUTDOWN_TIMEOUT_SECONDS=30
# Runware 계정 잔액 사전 확인(getDetails 의 balance.amount, USD). 사용 가능한 잔액이 이 값 이하이면 Pruna 생성을 막는다.
# 하루 사용액 상한(코드 고정 5달러, FITTING_DAILY_BUDGET_USD)과는 별개다.
FITTING_MIN_BALANCE_USD=1.00
# Runware 완료 알림 Webhook URL(https, 인증 token query 포함). 비밀값이므로 커밋·로그 금지. 비어 있으면 Pruna 제출을 시작하지 않는다.
VIRTUAL_FITTING_RUNWARE_WEBHOOK_URL=
# Runware Webhook 인증 토큰(RUNWARE_API_KEY 와 별개). 위 URL 의 token 값과 같아야 한다.
WEBHOOK_TOKEN=
# 모든 AI 서버가 PostgreSQL 로 공유하는 Pruna 생성 요청 제한: 진행 중 작업 수, HTTP 동시 전송 수, 전송 최소 간격(초)
VIRTUAL_FITTING_PRUNA_MAX_IN_FLIGHT=3
VIRTUAL_FITTING_PRUNA_MAX_CONCURRENT_SENDS=2
VIRTUAL_FITTING_PRUNA_MIN_SEND_INTERVAL_SECONDS=10

MAX_IMAGE_SIZE_MB=10
MAX_PROCESSING_IMAGE_SIDE=1600
MAX_CONCURRENT_BODY_VALIDATIONS=1
MAX_WAITING_BODY_VALIDATIONS=1

BODY_IMAGE_MAX_QUEUE_WAIT_SECONDS=10
REMBG_ENABLE_CPU_MEM_ARENA=false

BODY_IMAGE_VALIDATION_MODE=local
BODY_IMAGE_REMOTE_URL=
BODY_IMAGE_REMOTE_PROXY_KEY=
BODY_IMAGE_REMOTE_PROXY_SECRET=
BODY_IMAGE_REMOTE_API_KEY=

RUNWARE_VTON_API_KEY=
RUNWARE_LLM_API_KEY=

VIRTUAL_FITTING_VTON_CONCURRENCY=4
VIRTUAL_FITTING_VTON_QUEUE_SIZE=4
VIRTUAL_FITTING_VTON_QUEUE_TIMEOUT_SECONDS=30
VIRTUAL_FITTING_LLM_CONCURRENCY=4
VIRTUAL_FITTING_LLM_SLOT_WAIT_TIMEOUT_SECONDS=15

# --- 대화 (Chat) ---
OPENAI_API_KEY=
INTERNAL_API_KEY=
AUTH_DISABLED=
CHECKPOINT_DSN=
