# 복사해서 .env 로 쓴다. .env 는 커밋되지 않는다.
#
# 이 파일을 읽는 것은 scripts/ 의 개발용 도구뿐이다.
# app/ 은 환경변수만 읽으므로 운영에서는 컨테이너 환경변수로 주입한다.

# --- 가상피팅 ---
DATABASE_URL=postgresql://USER@localhost:5432/DB_NAME
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
# 검색 기반 추천 전용 async pool
SEARCH_DB_POOL_MIN_SIZE=1
SEARCH_DB_POOL_MAX_SIZE=5

# boto3는 운영에서 EC2 IAM Role을 사용한다. access key는 이 파일에 두지 않는다.
AWS_REGION=ap-northeast-2
S3_BUCKET=
# V2 비동기 가상피팅 Presigned URL 유효기간(초): 사용자 원본 GET, 결과 업로드 PUT, 결과 GET.
VIRTUAL_FITTING_USER_IMAGE_URL_EXPIRES_SECONDS=1800
VIRTUAL_FITTING_RESULT_UPLOAD_URL_EXPIRES_SECONDS=3600
VIRTUAL_FITTING_RESULT_IMAGE_URL_EXPIRES_SECONDS=600
# V2 비동기 가상피팅 SQS Standard 큐 URL(https://sqs.<AWS_REGION>.amazonaws.com/<계정ID>/<큐이름>).
# 큐·DLQ·IAM 은 Cloud 담당. 자격증명은 S3 와 같은 기본 credential chain(EC2 IAM Role)을 쓴다.
BE_FITTING_REQUEST_QUEUE_URL=
AI_FITTING_RESPONSE_QUEUE_URL=
BE_FITTING_RESPONSE_QUEUE_URL=

# 로컬에서 모델 경로를 바꿀 때만 설정한다. Docker 이미지는 빌드 단계에서 준비한다.
# BODY_IMAGE_MODEL_DIR=/absolute/path/to/body-image-models

# 전신 이미지 검증 메모리 보호. 파일 크기(MB), 모델에 넣을 긴 변 최대(px),
# 무거운 검증의 동시 실행 수와 대기 수(둘 다 차면 즉시 429 SERVER_BUSY).
MAX_IMAGE_SIZE_MB=10
MAX_PROCESSING_IMAGE_SIDE=1600
MAX_CONCURRENT_BODY_VALIDATIONS=1
MAX_WAITING_BODY_VALIDATIONS=1
# remote 모드에서 대기열 요청이 실행 슬롯을 기다리는 최대 시간(초). 넘으면 429. 전체 deadline 안에 포함된다.
# local 모드에는 적용하지 않는다(기존처럼 대기 시간 제한 없음).
BODY_IMAGE_MAX_QUEUE_WAIT_SECONDS=10
# rembg ONNX Runtime CPU memory arena. 요청 후 메모리가 남지 않게 끈다. 되돌릴 때만 true.
REMBG_ENABLE_CPU_MEM_ARENA=false

# 전신 이미지 검증을 어디서 할지. local(기본): 이 서버가 모델을 올려 직접 검증한다.
# remote: 모델을 올리지 않고 Modal T4 worker 에 HTTP 로 맡긴다(아래 값이 모두 필요하다).
BODY_IMAGE_VALIDATION_MODE=local
# worker base URL(https://...modal.run), Modal proxy auth token(Modal-Key/Modal-Secret),
# worker 의 INTERNAL_API_KEY(Bearer), 네트워크 단계별 timeout(초). 시간 초과는 재시도하지 않고 504.
BODY_IMAGE_REMOTE_URL=
BODY_IMAGE_REMOTE_PROXY_KEY=
BODY_IMAGE_REMOTE_PROXY_SECRET=
BODY_IMAGE_REMOTE_API_KEY=
BODY_IMAGE_REMOTE_TIMEOUT_SECONDS=90
# 요청을 받은 시점부터(대기열 대기 포함) 최종 응답까지의 전체 deadline(초). redirect 를 따라가도 다시 시작하지 않는다.
# 운영 예: 50(Backend timeout 60초보다 짧게).
# TIMEOUT 은 각 네트워크 단계(연결·전송·대기·읽기)의 상한이다. deadline 이 150초를 넘으면 Modal 이 150초에 보내는
# 303 을 받을 수 있게 TIMEOUT 도 150초보다 크게 둔다. staging 예: DEADLINE=200, TIMEOUT=180.
BODY_IMAGE_REMOTE_TOTAL_DEADLINE_SECONDS=90

RUNWARE_VTON_API_KEY=
# 가상피팅 comment/title 과 채팅 LLM 이 함께 쓴다.
RUNWARE_LLM_API_KEY=

# 가상피팅 동시 실행 제한(프로세스 단위). VTON 은 실행 수 + 대기 수가 모두 차면 즉시 429
# FITTING_SERVER_BUSY, 대기 시간(초)을 넘기면 429 FITTING_QUEUE_TIMEOUT. LLM 은 실행 수와 슬롯 대기
# 시간(초)을 제한하고, 대기 시간을 넘기면 fallback comment/title 로 정상 응답한다.
VIRTUAL_FITTING_VTON_CONCURRENCY=4
VIRTUAL_FITTING_VTON_QUEUE_SIZE=4
VIRTUAL_FITTING_VTON_QUEUE_TIMEOUT_SECONDS=30
VIRTUAL_FITTING_LLM_CONCURRENCY=4
VIRTUAL_FITTING_LLM_SLOT_WAIT_TIMEOUT_SECONDS=15

# --- 대화 (Chat) ---

# 검색 질의 임베딩 전용. 채팅 LLM 은 RUNWARE_LLM_API_KEY 로 간다.
OPENAI_API_KEY=

# 서버 간 인증. 비어 있으면 모든 요청이 401 로 거절된다.
# 개발용 서버(scripts/dev_server.py)는 AUTH_DISABLED=1 로 뜨므로 없어도 된다.
INTERNAL_API_KEY=
AUTH_DISABLED=

# 대화 상태 저장소. 비어 있으면 인메모리로 뜬다(재시작하면 사라진다).
#
# DATABASE_URL 과 같은 PostgreSQL 인스턴스를 쓰되 스키마를 나눈다. checkpointer 가
# 만드는 네 테이블(checkpoints, checkpoint_blobs, checkpoint_writes,
# checkpoint_migrations)이 상품 테이블과 섞이지 않게 하기 위해서다.
# 두 변수를 하나로 합치면 상품 조회까지 langgraph 스키마를 보게 된다.
#
# CHECKPOINT_DSN=postgresql://user:password@host:5432/ai?options=-csearch_path%3Dlanggraph
CHECKPOINT_DSN=

# 로컬 실행 전용
HOST=127.0.0.1
PORT=8000
RELOAD=1
