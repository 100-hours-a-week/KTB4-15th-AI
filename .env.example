MAX_IMAGE_SIZE_MB=10
MAX_PROCESSING_IMAGE_SIDE=1600
MAX_CONCURRENT_BODY_VALIDATIONS=1
MAX_WAITING_BODY_VALIDATIONS=1

BODY_IMAGE_MAX_QUEUE_WAIT_SECONDS=10
REMBG_ENABLE_CPU_MEM_ARENA=false

BODY_IMAGE_VALIDATION_MODE=local
BODY_IMAGE_REMOTE_URL=
BODY_IMAGE_REMOTE_PROXY_KEY=
BODY_IMAGE_REMOTE_PROXY_SECRET=
BODY_IMAGE_REMOTE_API_KEY=

RUNWARE_VTON_API_KEY=
RUNWARE_LLM_API_KEY=

VIRTUAL_FITTING_VTON_CONCURRENCY=4
VIRTUAL_FITTING_VTON_QUEUE_SIZE=4
VIRTUAL_FITTING_VTON_QUEUE_TIMEOUT_SECONDS=30
VIRTUAL_FITTING_LLM_CONCURRENCY=4
VIRTUAL_FITTING_LLM_SLOT_WAIT_TIMEOUT_SECONDS=15

