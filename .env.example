# 복사해서 .env 로 쓴다. .env 는 커밋되지 않는다.
#
# 이 파일을 읽는 것은 scripts/ 의 개발용 도구뿐이다.
# app/ 은 환경변수만 읽으므로 운영에서는 컨테이너 환경변수로 주입한다.

# --- 가상피팅 ---
DATABASE_URL=postgresql://USER@localhost:5432/DB_NAME
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10

# boto3는 운영에서 EC2 IAM Role을 사용한다. access key는 이 파일에 두지 않는다.
AWS_REGION=ap-northeast-2
S3_BUCKET=


PRUNA_API_KEY=
RUNWARE_VTON_API_KEY=
RUNWARE_LLM_API_KEY=

# --- 대화 (Chat) ---

OPENAI_API_KEY=

# 서버 간 인증. 비어 있으면 모든 요청이 401 로 거절된다.
# 개발용 서버(scripts/dev_server.py)는 AUTH_DISABLED=1 로 뜨므로 없어도 된다.
INTERNAL_API_KEY=
AUTH_DISABLED=

# 대화 상태 저장소. 비어 있으면 인메모리로 뜬다(재시작하면 사라진다).
#
# DATABASE_URL 과 같은 PostgreSQL 인스턴스를 쓰되 스키마를 나눈다. checkpointer 가
# 만드는 네 테이블(checkpoints, checkpoint_blobs, checkpoint_writes,
# checkpoint_migrations)이 상품 테이블과 섞이지 않게 하기 위해서다.
# 두 변수를 하나로 합치면 상품 조회까지 langgraph 스키마를 보게 된다.
#
# CHECKPOINT_DSN=postgresql://user:password@host:5432/ai?options=-csearch_path%3Dlanggraph
CHECKPOINT_DSN=

# 로컬 실행 전용
HOST=127.0.0.1
PORT=8000
RELOAD=1
